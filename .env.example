# ============================================================
# BNI Hlasovani — .env.local
# Zkopiruj tento soubor do .env.local a vypln hodnoty
# ============================================================

# --- Neon PostgreSQL ---
# Pooler URL (povinne! nikoliv direct connection)
# Format: postgresql://user:password@ep-xxx-pooler.region.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Direct connection URL (pro migrace — drizzle-kit push)
# Format: postgresql://user:password@ep-xxx.region.neon.tech/dbname?sslmode=require
DATABASE_URL_UNPOOLED=

# --- Session ---
# Min 32 znaku nahodny string (pouzij: openssl rand -hex 32)
SESSION_SECRET=

# --- Resend (email) ---
# API klic z https://resend.com/api-keys
RESEND_API_KEY=

# Odesilaci email adresa (musi byt overena v Resend)
RESEND_FROM_EMAIL=noreply@bni-plzen.cz

# --- Cron / Report secrets ---
# Nahodne stringy pro autorizaci cron a report endpointu
# (pouzij: openssl rand -hex 16)
CRON_SECRET=
REPORT_SECRET=

# --- App URL ---
# Base URL aplikace (pro magic link generovani)
# Lokalne: http://localhost:3000
# Produkce: https://your-domain.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Timezone ---
# Timezone pro hlasovaci okno (default: Europe/Prague)
VOTING_TIMEZONE=Europe/Prague

# --- Event token encryption ---
# 32-bajtovy nahodny klic jako hex string (64 znaku)
# Generovani v prohlizeci: Array.from(crypto.getRandomValues(new Uint8Array(32))).map(b=>b.toString(16).padStart(2,'0')).join('')
EVENT_TOKEN_ENCRYPTION_KEY=

# --- Seed admin (pro scripts/seed-admin.ts) ---
SEED_ADMIN_EMAIL=admin@bni-plzen.cz
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_NAME=Admin
